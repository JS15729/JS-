# ============================================
# 私有云存储系统 - 环境变量配置
# ============================================
# 复制此文件为 .env 并修改相应配置
# cp .env.example .env
# ============================================

# ---------- 服务器配置 ----------
# 服务器端口
PORT=3000

# 环境（development / production）
NODE_ENV=development

# ---------- 数据库配置 ----------
# MongoDB 连接URI
MONGODB_URI=mongodb://localhost:27017/private-cloud-storage

# ---------- JWT 配置 ----------
# 🔒 JWT 密钥（必须设置，不能使用默认值！）
# 建议：openssl rand -base64 32
JWT_SECRET=your-super-strong-secret-key-min-32-chars

# JWT 过期时间（默认2小时）
JWT_EXPIRES_IN=2h

# ---------- 跨域配置 ----------
# 🔒 允许的域名（逗号分隔，生产环境必须设置）
# 本地开发：http://localhost:5173,http://localhost:3000
# 生产环境：https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 速率限制配置 ----------
# 速率限制时间窗口（秒，默认60秒）
THROTTLE_TTL=60

# 速率限制请求次数（默认100次/时间窗口）
THROTTLE_LIMIT=100

# ---------- 文件上传配置 ----------
# 上传目录
UPLOAD_DIR=./uploads

# 分片大小（字节，默认5MB）
CHUNK_SIZE=5242880

# 最大文件大小（字节，默认10GB）
MAX_FILE_SIZE=10737418240

# ---------- 存储配额配置 ----------
# 默认用户存储配额（字节，默认10GB）
DEFAULT_STORAGE_QUOTA=10737418240

# ---------- 备份配置 ----------
# 备份目录
BACKUP_DIR=./backups

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# ---------- 日志配置 ----------
# 日志级别（error / warn / info / debug / verbose）
LOG_LEVEL=info

# ---------- Redis 配置（可选，用于缓存和分布式部署）----------
# Redis 主机
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码（可选）
# REDIS_PASSWORD=your-redis-password

# Redis 数据库编号
REDIS_DB=0

# ---------- 分布式存储配置（可选）----------
# MinIO 端点
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=files

# ---------- 邮件配置（可选，用于通知）----------
# SMTP 主机
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_FROM=noreply@example.com

# ---------- 安全配置 ----------
# 启用HTTPS（生产环境必须为true）
ENABLE_HTTPS=false

# HTTPS 证书路径（ENABLE_HTTPS=true时需要）
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# 密码加密轮数
BCRYPT_SALT_ROUNDS=10

# ---------- 性能配置 ----------
# 数据库连接池大小
MONGODB_POOL_SIZE=100

# 请求体大小限制
BODY_SIZE_LIMIT=100mb

# ---------- 功能开关 ----------
# 启用注册（false则需要通过邀请码注册）
ENABLE_REGISTRATION=true

# 启用文件版本控制
ENABLE_FILE_VERSIONING=false

# 启用操作日志
ENABLE_AUDIT_LOG=true
